+
+static int set_power_saving_app_cmd(struct gowin_led_screen *screen, bool on)
+{
+	u8 buf[2] = { CMD_SET_POWER_SAVING, on ? 0x01 : 0x00 };
+	return spi_write(screen->spi, buf, 2);
