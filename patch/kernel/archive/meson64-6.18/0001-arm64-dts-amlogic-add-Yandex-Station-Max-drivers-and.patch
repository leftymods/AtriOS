diff --git a/arch/arm64/boot/dts/amlogic/meson-g12a-yandex-station-max.dts b/arch/arm64/boot/dts/amlogic/meson-g12a-yandex-station-max.dts
new file mode 100644
index 000000000..a5bb1516a
--- /dev/null
+++ b/arch/arm64/boot/dts/amlogic/meson-g12a-yandex-station-max.dts
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Device Tree Source for Yandex Station Max (Quasar 2)
+ *
+ * Based on Amlogic Meson G12A S905X2
+ * Mainline Linux 6.x DTS
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/sound/meson-g12a-tohdmitx.h>
+#include "meson-g12a.dtsi"
+
+/ {
+	compatible = "yandex,station-max", "amlogic,g12a";
+	model = "Yandex Station Max";
+
+	aliases {
+		serial0 = &uart_AO;
+		serial1 = &uart_A;
+		serial4 = &uart_C;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x0 0x0 0x80000000>; /* 2GB RAM */
+	};
+
+	/* Mic Mute Push-Button */
+	gpio_keys: gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-0 = <&keypad_pins>;
+		pinctrl-names = "default";
+
+		button-micmute {
+			label = "Mic Mute";
+			linux,code = <KEY_MICMUTE>; /* 248 */
+			gpios = <&gpio_ao GPIOAO_3 GPIO_ACTIVE_LOW>;
+			debounce-interval = <20>;
+			wakeup-source;
+		};
+	};
+
+	/* Rotary Volume Encoder */
+	rotary_volume: rotary-volume {
+		compatible = "rotary-volume";
+		pinctrl-0 = <&rotary_pins>;
+		pinctrl-names = "default";
+		gpios = <&gpio GPIOH_4 GPIO_ACTIVE_HIGH>,
+			<&gpio GPIOH_5 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+
+	/* ZigBee Hardware Control */
+	zigbee_control: zigbee-control {
+		compatible = "yandex,zigbee-control";
+		zb-power-gpios = <&gpio GPIOZ_3 GPIO_ACTIVE_HIGH>;
+		zb-reset-gpios = <&gpio GPIOZ_4 GPIO_ACTIVE_LOW>;
+		zb-boot-gpios  = <&gpio GPIOZ_5 GPIO_ACTIVE_LOW>;
+		status = "okay";
+	};
+
+	/* Quasar PCBA ID Parser */
+	pcba_ids: pcba-ids {
+		compatible = "yandex,pcba-ids", "pcba-ids";
+		status = "okay";
+	};
+
+	sound {
+		compatible = "amlogic,axg-sound-card";
+		model = "YANDEX-STATION-MAX";
+
+		dai-link-0 {
+			sound-dai = <&tdmb>;
+			codec-0 {
+				sound-dai = <&sy6045s_woofer>;
+			};
+			codec-1 {
+				sound-dai = <&sy6045s_tweeter>;
+			};
+		};
+
+		dai-link-1 {
+			sound-dai = <&tdmc>;
+			codec-0 {
+				sound-dai = <&es8156_dac>;
+			};
+		};
+
+		dai-link-2 {
+			sound-dai = <&pdm>;
+			codec-0 {
+				sound-dai = <&es7210_adc>;
+			};
+		};
+	};
+};
+
+/* High-speed SPI to Gowin FPGA (25x16 LED Screen & Touch) */
+&spifc {
+	status = "okay";
+	pinctrl-0 = <&spifc_pins>;
+	pinctrl-names = "default";
+
+	gowin_screen: led-panel@0 {
+		compatible = "gowin,led-screen", "yandex,station-max-led-screen";
+		reg = <0>;
+		spi-max-frequency = <25000000>;
+		reconfig-gpios  = <&gpio GPIOC_0 GPIO_ACTIVE_HIGH>;
+		mode-gpios      = <&gpio GPIOC_1 GPIO_ACTIVE_HIGH>;
+		touch-irq-gpios = <&gpio GPIOC_2 GPIO_ACTIVE_LOW>;
+		jtag-tck-gpios  = <&gpio GPIOC_3 GPIO_ACTIVE_LOW>;
+		jtag-tms-gpios  = <&gpio GPIOC_4 GPIO_ACTIVE_HIGH>;
+		jtag-tdi-gpios  = <&gpio GPIOC_5 GPIO_ACTIVE_LOW>;
+		jtag-tdo-gpios  = <&gpio GPIOC_6 GPIO_ACTIVE_LOW>;
+		status = "okay";
+	};
+};
+
+/* I2C Bus 2: Audio Amplifiers and Codecs */
+&i2c2 {
+	status = "okay";
+	pinctrl-0 = <&i2c2_sda_h_pins>, <&i2c2_sck_h_pins>;
+	pinctrl-names = "default";
+
+	/* Silergy SY6045S Woofer Amplifier */
+	sy6045s_woofer: amplifier@2b {
+		compatible = "silergy,sy6045s";
+		reg = <0x2b>;
+		#sound-dai-cells = <0>;
+		settings-file = "sy6045s-woofer-settings.txt";
+		reset-gpios = <&gpio GPIOH_6 GPIO_ACTIVE_LOW>;
+		fault-gpios = <&gpio GPIOH_7 GPIO_ACTIVE_LOW>;
+		status = "okay";
+	};
+
+	/* Silergy SY6045S Tweeter Amplifier */
+	sy6045s_tweeter: amplifier@2a {
+		compatible = "silergy,sy6045s";
+		reg = <0x2a>;
+		#sound-dai-cells = <0>;
+		settings-file = "sy6045s-tweeters-settings.txt";
+		reset-gpios = <&gpio GPIOH_8 GPIO_ACTIVE_LOW>;
+		fault-gpios = <&gpio GPIOH_9 GPIO_ACTIVE_LOW>;
+		status = "okay";
+	};
+
+	/* Everest ES8156 Headphone DAC */
+	es8156_dac: codec@10 {
+		compatible = "everest,es8156";
+		reg = <0x10>;
+		#sound-dai-cells = <0>;
+		spk-con-gpios = <&gpio GPIOA_14 GPIO_ACTIVE_HIGH>;
+		hp-det-gpios  = <&gpio GPIOA_15 GPIO_ACTIVE_LOW>;
+		debounce-time = <200>;
+		status = "okay";
+	};
+
+	/* Everest ES7210 4-Channel Microphone ADC */
+	es7210_adc: codec@40 {
+		compatible = "everest,es7210_4ch";
+		reg = <0x40>;
+		#sound-dai-cells = <0>;
+		status = "okay";
+	};
+
+	/* Lite-On LTR-308ALS Ambient Light Sensor */
+	ltr308: light-sensor@53 {
+		compatible = "liteon,ltr308als01", "liteon,ltr308";
+		reg = <0x53>;
+		status = "okay";
+	};
+};
+
+/* UART for Zigbee Module */
+&uart_C {
+	status = "okay";
+	pinctrl-0 = <&uart_c_pins>;
+	pinctrl-names = "default";
+};
diff --git a/drivers/iio/light/Kconfig b/drivers/iio/light/Kconfig
index b567efdc7..dd7a80927 100644
--- a/drivers/iio/light/Kconfig
+++ b/drivers/iio/light/Kconfig
@@ -397,6 +397,17 @@ config SENSORS_LM3533
 	  changes. The ALS-control output values can be set per zone for the
 	  three current output channels.
 
+config LTR308ALS
+	tristate "Lite-On LTR-308ALS-01 ambient light sensor"
+	depends on I2C
+	select REGMAP_I2C
+	help
+	  If you say yes here you get support for the Lite-On LTR-308ALS-01
+	  ambient light sensor found on Yandex Station Max.
+
+	  This driver can also be built as a module. If so, the module
+	  will be called ltr308als01.
+
 config LTR390
 	tristate "LTR-390UV-01 ambient light and UV sensor"
 	depends on I2C
diff --git a/drivers/iio/light/Makefile b/drivers/iio/light/Makefile
index c0048e0d5..f143ff137 100644
--- a/drivers/iio/light/Makefile
+++ b/drivers/iio/light/Makefile
@@ -35,6 +35,7 @@ obj-$(CONFIG_ISL29125)		+= isl29125.o
 obj-$(CONFIG_ISL76682)		+= isl76682.o
 obj-$(CONFIG_JSA1212)		+= jsa1212.o
 obj-$(CONFIG_SENSORS_LM3533)	+= lm3533-als.o
+obj-$(CONFIG_LTR308ALS)		+= ltr308als01.o
 obj-$(CONFIG_LTR390)		+= ltr390.o
 obj-$(CONFIG_LTR501)		+= ltr501.o
