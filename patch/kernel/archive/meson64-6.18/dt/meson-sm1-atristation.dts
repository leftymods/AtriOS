/*
 * Copyright (c) 2024 AtriMods
 * Author: Lefty <leftymods@gmail.com>
 *
 * AtriStation - Amlogic S905X3-based smart display board
 * Features: HDMI, LED ring, microphone array, speakers, WiFi/BT
 */

/dts-v1/;

#include "meson-sm1.dtsi"
#include <dt-bindings/gpio/meson-g12a-gpio.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/clock/axg-audio-clkc.h>
#include <dt-bindings/sound/meson-g12a-toacodec.h>
#include <dt-bindings/sound/meson-g12a-tohdmitx.h>

/ {
	compatible = "atristation,atristation", "amlogic,sm1";
	model = "AtriStation";

	aliases {
		serial0 = &uart_AO;
		serial1 = &uart_A;	/* Bluetooth -> ttyAML1 */
		serial2 = &uart_AO_B;	/* Zigbee    -> ttyAML2 */
		ethernet0 = &ethmac;
		led-controller0 = &is31fl3236_3c;
		led-controller1 = &is31fl3236_3f;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x80000000>;
	};

	vrtc_alarm: rtc {
		compatible = "amlogic,aml_vrtc";
		alarm_reg_addr = <0xff8000a8>;
		timer_e_addr = <0xffd0f188>;
		init_date = "2015/01/01";
		status = "okay";
	};

	pcba_ids: pcba-ids {
		compatible = "atri,pcba-ids";
		eeproms = <&pcba_eeprom>;
		eeprom-names = "mainboard";
		status = "okay";
	};

	emmc_pwrseq: emmc-pwrseq {
		compatible = "mmc-pwrseq-emmc";
		reset-gpios = <&gpio BOOT_12 GPIO_ACTIVE_LOW>;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		/* Android DTB: wifi.power_on_pin = GPIOX_8 (0x48), asserted high */
		reset-gpios = <&gpio GPIOX_8 GPIO_ACTIVE_HIGH>;
		clocks = <&wifi32k>;
		clock-names = "ext_clock";
		post-power-on-delay-ms = <200>;
	};

	vddcpu: regulator-vddcpu {
		compatible = "pwm-regulator";
		pwms = <&pwm_AO_cd 1 1500 0>;
		pwm-dutycycle-range = <100 0>;
		regulator-name = "VDDCPU";
		regulator-min-microvolt = <721000>;
		regulator-max-microvolt = <1022000>;
		regulator-boot-on;
		regulator-always-on;
		vin-supply = <&dc_in>;
	};

	/* GPU rail: all SM1 GPU OPPs run at 0.8V; board feeds MALI from an
	 * always-on buck, so declare a fixed 0.8V supply for panfrost devfreq */
	vddgpu: regulator-vddgpu {
		compatible = "regulator-fixed";
		regulator-name = "VDDGPU";
		regulator-min-microvolt = <800000>;
		regulator-max-microvolt = <800000>;
		vin-supply = <&main_12v>;
		regulator-always-on;
	};

	/* Station 2 has no microSD slot; GPIOAO_3 is the Zigbee UART RX
	 * (stock DTB: uart_ao_b rx_b_3). Node kept disabled for reference. */
	tflash_vdd: regulator-tflash_vdd {
		compatible = "regulator-fixed";
		regulator-name = "TFLASH_VDD";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_5v>;
		gpio = <&gpio_ao GPIOAO_3 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		status = "disabled";	};

	flash_1v8: regulator-flash_1v8 {
		compatible = "regulator-fixed";
		regulator-name = "FLASH_1V8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_3v3>;
		regulator-boot-on;
	};

	main_12v: regulator-main_12v {
		compatible = "regulator-fixed";
		regulator-name = "MAIN_12V";
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
		vin-supply = <&dc_in>;
		regulator-boot-on;
	};

	vcc_5v: regulator-vcc_5v {
		compatible = "regulator-fixed";
		regulator-name = "VCC_5V";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&main_12v>;
		regulator-boot-on;
	};

	vcc_1v8: regulator-vcc_1v8 {
		compatible = "regulator-fixed";
		regulator-name = "VCC_1V8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_3v3>;
		regulator-always-on;
	};

	vcc_3v3: regulator-vcc_3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VCC_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&main_12v>;
		regulator-boot-on;
	};

	vddao_3v3: regulator-vddao_3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VDDAO_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&main_12v>;
		regulator-boot-on;
	};

	dc_in: regulator-dc_in {
		compatible = "regulator-fixed";
		regulator-name = "DC_IN";
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
		regulator-boot-on;
	};

	sound {
		compatible = "amlogic,axg-sound-card";
		model = "ATRISTATION";
		audio-aux-devs = <&tdmout_b>;
		audio-widgets = "Headphone", "Headphones";
		audio-routing =
			"Headphones", "LOUT",
			"Headphones", "ROUT",
			"TDMOUT_B IN 0", "FRDDR_A OUT 0";

		clocks = <&clkc CLKID_MPLL2>,
			 <&clkc CLKID_MPLL0>;
		assigned-clocks = <&clkc CLKID_MPLL2>,
				  <&clkc CLKID_MPLL0>;
		assigned-clock-rates = <294912000>,
				       <270950400>;

		dai-link-0 {
			sound-dai = <&frddr_a>;
		};

		dai-link-3 {
			sound-dai = <&tdmif_b>;
			dai-format = "i2s";
			bitclock-master = <&tdmif_b>;
			frame-master = <&tdmif_b>;
			dai-tdm-slot-tx-mask-0 = <1 1>;
			mclk-fs = <256>;

			codec-0 { sound-dai = <&tweeter_amp>; };
			codec-1 { sound-dai = <&woofer_amp>; };
			codec-2 { sound-dai = <&es8156>; };
		};
	};

	/* PDM microphone array (4 channels) */
	dmics: dmics {
		compatible = "dmic-codec";
		#sound-dai-cells = <0>;
		num-channels = <4>;
		wakeup-delay-ms = <50>;
		sound-name-prefix = "DMIC";
	};

	/* HDMI connector */
	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&hdmi_tx_tmds_out>;
			};
		};
	};

	/* USB power enable
	 * No VBUS GPIO on this board (stock Yandex DTB wires none);
	 * GPIOH_6 is the FPGA JTAG TDO line, do not claim it here. */
	usb_pwr_en: regulator-usb-pwr-en {
		compatible = "regulator-fixed";
		regulator-name = "USB_PWR_EN";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc_5v>;
		regulator-boot-on;
		regulator-always-on;
	};

	/* 32.768kHz clock for WiFi */
	wifi32k: wifi32k {
		compatible = "pwm-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		/* Android DTB: pwm@19000 ch0, period 30541 (~32.756 kHz), duty ~48% */
		pwms = <&pwm_ef 0 30541 0>;
	};

	/* VDDAO 1.8V for SDIO/BT I/O */
	vddio_ao1v8: regulator-vddio-ao1v8 {
		compatible = "regulator-fixed";
		regulator-name = "VDDIO_AO1V8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vddao_3v3>;
		regulator-always-on;
	};

	/* SY6045S amplifier 20V supply enable.
	 * Board owner confirmed: ampl_pwr = GPIOX_10 (the old AO_10 was
	 * a misparse of the vendor dump). This frees GPIOAO_10 for the
	 * volume knob phase B. sy6045s driver sequences it at step 4. */
	amp_20v: regulator-20v-amp {
		compatible = "regulator-fixed";
		regulator-name = "20V_AMPL";
		regulator-min-microvolt = <20000000>;
		regulator-max-microvolt = <20000000>;
		gpio = <&gpio GPIOX_10 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/* Volume knob per vendor: push A/B emitting KEY_VOLUMEUP/DOWN */
	rotary-volume {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;

		vol-up {
			label = "volume-up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpio GPIOZ_10 GPIO_ACTIVE_LOW>;
		};

		vol-down {
			label = "volume-down";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpio_ao GPIOAO_10 GPIO_ACTIVE_LOW>;
		};
	};

	zigbee_control: zigbee-control {
		compatible = "yandex,zigbee-control";
		zb-reset-gpios = <&gpio GPIOX_17 GPIO_ACTIVE_LOW>;
		zb-boot-gpios = <&gpio GPIOX_11 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	/* Bluetooth: matches vendor DTB gpio_reset=0x16 0x53,
	 * gpio_hostwake=0x16 0x55 */
	bt-dev {
		compatible = "amlogic,bt-dev";
		dev_name = "bt-dev";
		status = "okay";
		gpio_reset = <&gpio 0x53 GPIO_ACTIVE_HIGH>;
		gpio_hostwake = <&gpio 0x55 GPIO_ACTIVE_HIGH>;
	};

	/* WiFi: matches vendor DTB aml_wifi:
	 * interrupt_pin=0x16 0x49, power_on_pin=0x16 0x48 */
	wifi {
		compatible = "amlogic,aml_wifi";
		dev_name = "aml_wifi";
		status = "okay";
		interrupt_pin = <&gpio 0x49 GPIO_ACTIVE_LOW>;
		irq_trigger_type = "GPIO_IRQ_LOW";
		power_on_pin = <&gpio 0x48 GPIO_ACTIVE_HIGH>;
		pwm_config = <&wifi_pwm_conf>;
	};

	/* WiFi/BT 32.768kHz PWM config as in vendor DTB */
	wifi_pwm_conf: wifi-pwm-conf {
		pwm_channel1_conf {
			pwms = <&pwm_ef 0 0x774d 0x00>;
			duty-cycle = <0x3ba6>;
			times = <0x0a>;
		};
		pwm_channel2_conf {
			pwms = <&pwm_ef 2 0x7724 0x00>;
			duty-cycle = <0x3b92>;
			times = <0x0c>;
		};
	};

	gpio-keys-polled {
		compatible = "gpio-keys-polled";
		poll-interval = <50>;
		pinctrl-names = "default";
		pinctrl-0 = <&button_pullup_pins>;
		status = "okay";

		button-micmute {
			label = "micmute";
			gpios = <&gpio GPIOA_15 GPIO_ACTIVE_LOW>;
			/* Key 248: KEY_MICMUTE / Yandex vendor MUTE */
			linux,code = <KEY_MICMUTE>;
		};
	};

	/* RGB LED ring - 24 multicolor groups */
	ring0: rgb0 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring0";
		leds = <&led_3c_blue0>, <&led_3c_green0>, <&led_3c_red0>;
	};
	ring1: rgb1 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring1";
		leds = <&led_3c_blue1>, <&led_3c_green1>, <&led_3c_red1>;
	};
	ring2: rgb2 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring2";
		leds = <&led_3c_blue2>, <&led_3c_green2>, <&led_3c_red2>;
	};
	ring3: rgb3 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring3";
		leds = <&led_3c_blue3>, <&led_3c_green3>, <&led_3c_red3>;
	};
	ring4: rgb4 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring4";
		leds = <&led_3c_blue4>, <&led_3c_green4>, <&led_3c_red4>;
	};
	ring5: rgb5 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring5";
		leds = <&led_3c_blue5>, <&led_3c_green5>, <&led_3c_red5>;
	};
	ring6: rgb6 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring6";
		leds = <&led_3c_blue6>, <&led_3c_green6>, <&led_3c_red6>;
	};
	ring7: rgb7 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring7";
		leds = <&led_3c_blue7>, <&led_3c_green7>, <&led_3c_red7>;
	};
	ring8: rgb8 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring8";
		leds = <&led_3c_blue8>, <&led_3c_green8>, <&led_3c_red8>;
	};
	ring9: rgb9 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring9";
		leds = <&led_3c_blue9>, <&led_3c_green9>, <&led_3c_red9>;
	};
	ring10: rgb10 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring10";
		leds = <&led_3c_blue10>, <&led_3c_green10>, <&led_3c_red10>;
	};
	ring11: rgb11 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring11";
		leds = <&led_3c_blue11>, <&led_3c_green11>, <&led_3c_red11>;
	};
	ring12: rgb12 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring12";
		leds = <&led_3f_blue12>, <&led_3f_green12>, <&led_3f_red12>;
	};
	ring13: rgb13 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring13";
		leds = <&led_3f_blue13>, <&led_3f_green13>, <&led_3f_red13>;
	};
	ring14: rgb14 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring14";
		leds = <&led_3f_blue14>, <&led_3f_green14>, <&led_3f_red14>;
	};
	ring15: rgb15 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring15";
		leds = <&led_3f_blue15>, <&led_3f_green15>, <&led_3f_red15>;
	};
	ring16: rgb16 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring16";
		leds = <&led_3f_blue16>, <&led_3f_green16>, <&led_3f_red16>;
	};
	ring17: rgb17 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring17";
		leds = <&led_3f_blue17>, <&led_3f_green17>, <&led_3f_red17>;
	};
	ring18: rgb18 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring18";
		leds = <&led_3f_blue18>, <&led_3f_green18>, <&led_3f_red18>;
	};
	ring19: rgb19 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring19";
		leds = <&led_3f_blue19>, <&led_3f_green19>, <&led_3f_red19>;
	};
	ring20: rgb20 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring20";
		leds = <&led_3f_blue20>, <&led_3f_green20>, <&led_3f_red20>;
	};
	ring21: rgb21 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring21";
		leds = <&led_3f_blue21>, <&led_3f_green21>, <&led_3f_red21>;
	};
	ring22: rgb22 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring22";
		leds = <&led_3f_blue22>, <&led_3f_green22>, <&led_3f_red22>;
	};
	ring23: rgb23 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		label = "ring23";
		leds = <&led_3f_blue23>, <&led_3f_green23>, <&led_3f_red23>;
	};
};

&arb {
	status = "okay";
};

&cec_AO {
	pinctrl-0 = <&cec_ao_a_h_pins>;
	pinctrl-names = "default";
	status = "disabled";
	hdmi-phandle = <&hdmi_tx>;
};

&cecb_AO {
	pinctrl-0 = <&cec_ao_b_h_pins>;
	pinctrl-names = "default";
	status = "okay";
	hdmi-phandle = <&hdmi_tx>;
};

&clk_msr {
	status = "okay";
};

&clkc_audio {
	status = "okay";
};

&cpu0 {
	cpu-supply = <&vddcpu>;
};

&cpu1 {
	cpu-supply = <&vddcpu>;
};

&cpu2 {
	cpu-supply = <&vddcpu>;
};

&cpu3 {
	cpu-supply = <&vddcpu>;
};

&ethmac {
	status = "okay";
	pinctrl-0 = <&eth_pins>, <&eth_rgmii_pins>;
	pinctrl-names = "default";
	phy-mode = "rgmii";
	phy-handle = <&external_phy>;
	amlogic,tx-delay-ns = <2>;
};

&ext_mdio {
	external_phy: ethernet-phy@0 {
		reg = <0>;
		max-speed = <1000>;
	};
};

&frddr_a {
	status = "okay";
};

&frddr_b {
	status = "okay";
};

&frddr_c {
	status = "okay";
};

&hdmi_tx {
	status = "okay";
	pinctrl-0 = <&hdmitx_hpd_pins>, <&hdmitx_ddc_pins>;
	pinctrl-names = "default";
	hdmi-supply = <&vcc_5v>;
};

&hdmi_tx_tmds_port {
	hdmi_tx_tmds_out: endpoint {
		remote-endpoint = <&hdmi_connector_in>;
	};
};

&ir {
	status = "okay";
	pinctrl-0 = <&remote_input_ao_pins>;
	pinctrl-names = "default";
};

&mali {
	mali-supply = <&vddgpu>;
};

&pwm_AO_ab {
	pinctrl-0 = <&pwm_ao_a_pins>;
	pinctrl-names = "default";
};

&pwm_AO_cd {
	pinctrl-0 = <&pwm_ao_d_e_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&saradc {
	status = "okay";
	vref-supply = <&vddio_ao1v8>;
};

/* SD card - disabled, no SD slot on AtriStation */
&sd_emmc_b {
	status = "disabled";
};

/* eMMC */
&sd_emmc_c {
	status = "okay";
	pinctrl-0 = <&emmc_ctrl_pins>, <&emmc_data_8b_pins>, <&emmc_ds_pins>;
	pinctrl-1 = <&emmc_clk_gate_pins>;
	pinctrl-names = "default", "clk-gate";
	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	max-frequency = <200000000>;
	disable-wp;
	mmc-pwrseq = <&emmc_pwrseq>;
	vmmc-supply = <&vcc_3v3>;
	vqmmc-supply = <&flash_1v8>;
};

&tdmif_a {
	status = "okay";
	pinctrl-0 = <&tdm_a_dout0_pins>, <&tdm_a_din0_pins>,
		    <&tdm_a_fs_pins>, <&tdm_a_sclk_pins>;
	pinctrl-names = "default";
};

&tdmif_b {
	status = "okay";
	pinctrl-0 = <&tdm_ao_b_dout2_pins>, <&tdm_ao_b_din0_pins>,
		    <&tdm_ao_b_fs_pins>, <&tdm_ao_b_sclk_pins>,
		    <&mclk0_ao_pins>;
	pinctrl-names = "default";
};

&tdmout_a {
	status = "okay";
};

&tdmout_b {
	status = "okay";
};

&tdmin_b {
	status = "okay";
};

&toddr_a {
	status = "okay";
};

&toddr_b {
	status = "okay";
};

&toddr_c {
	status = "okay";
};

&pdm {
	status = "okay";
	pinctrl-0 = <&pdm_dclk_c_pins>, <&pdm_din0_c_pins>,
		    <&pdm_din1_c_pins>, <&pdm_din2_c_pins>,
		    <&pdm_din3_c_pins>;
	pinctrl-names = "default";
};

&toacodec {
	status = "okay";
};

&tohdmitx {
	status = "okay";
};

&uart_AO {
	status = "okay";
	pinctrl-0 = <&uart_ao_a_pins>;
	pinctrl-names = "default";
};

&usb {
	status = "okay";
	vbus-supply = <&usb_pwr_en>;
};

&usb2_phy0 {
	phy-supply = <&vcc_5v>;
};

/* I2C0 - LED ring, light sensor, EEPROM (GPIOZ pins to avoid SD card conflict) */
&i2c0 {
	status = "okay";
