	pcba_eeprom: eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
		vcc-supply = <&vcc_3v3>;
		status = "okay";
	};

	als@53 {
		compatible = "liteon,ltrf216a";
		reg = <0x53>;
		status = "okay";
	};
};

/* SPI1 - Quasar LED screen.
 * Bus pins (spicc1_pins -> GPIOH_4/5/6) are muxed by the led_panel child:
 * it owns the default/jtag pinctrl states for FPGA JTAG bit-banging.
 * Duplicating spicc1_pins on the parent makes pinctrl refuse the child's
 * request ("pin GPIOH_4 already requested by ffd15000.spi") and the panel
 * never binds. */
&spicc1 {
	status = "okay";
	pinctrl-names = "default";
	num-cs = <1>;
	cs-gpios = <&gpio GPIOH_7 GPIO_ACTIVE_LOW>;

	led_panel: led-panel@0 {
		compatible = "atri,led-panel", "ya,led-panel";
		reg = <0>;
		spi-max-frequency = <4000000>;
		max-brightness = <200>;
		pinctrl-names = "default", "jtag";
		pinctrl-0 = <&spicc1_pins>;
		pinctrl-1 = <&led_panel_jtag_pins>;
		reset-gpios = <&gpio GPIOX_9 GPIO_ACTIVE_LOW>;
		/* GPIOH output register, bit 8 = GPIOH_8 (JTAG TCK) */
		jtag_tck_desc = <0xff634468 0x08>;
		jtag_reconfig-gpios = <&gpio BOOT_0 GPIO_ACTIVE_LOW>;
		jtag_sel-gpios = <&gpio_ao GPIOE_2 GPIO_ACTIVE_HIGH>;
		jtag_tck-gpios = <&gpio GPIOH_8 GPIO_ACTIVE_HIGH>;
		jtag_tdi-gpios = <&gpio GPIOH_5 GPIO_ACTIVE_HIGH>;
		jtag_tdo-gpios = <&gpio GPIOH_6 GPIO_ACTIVE_HIGH>;
		jtag_tms-gpios = <&gpio GPIOH_7 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

/*
 * FPGA JTAG bit-bang shares the spicc1 pins. The meson pinctrl driver
 * does not re-mux pins on gpio_request, so switching between SPI and
 * JTAG requires explicit pinctrl states on the led_panel node.
 */
&periphs_pinctrl {
	led_panel_jtag_pins: led-panel-jtag {
		mux {
			groups = "GPIOH_5", "GPIOH_6", "GPIOH_7", "GPIOH_8";
			function = "gpio_periphs";
			bias-disable;
		};
	};

	/* Buttons idle high; without internal pull-up the micmute line
	 * floats and reports a stuck key */
	button_pullup_pins: button-pullup {
		mux {
			groups = "GPIOA_15";
			function = "gpio_periphs";
			bias-pull-up;
		};
	};
};

/* I2C2 on Z-pins (GPIOZ_14/15) - SY6045S amps, ES7210 ADC, IS31FL3733 LED */
&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2_sda_z_pins>, <&i2c2_sck_z_pins>;
	pinctrl-names = "default";
	clock-frequency = <300000>;

	es8156: es8156@8 {
		compatible = "everest,es8156";
		#sound-dai-cells = <0>;
		reg = <0x08>;
		clocks = <&clkc_audio AUD_CLKID_MST_B_MCLK>;
		clock-names = "mclk";
		status = "okay";
	};

	tweeter_amp: sy6045s@2a {
		compatible = "silergy,sy6045s";
		reg = <0x2a>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Tweeters";
		vddio-supply = <&vcc_3v3>;
		pvdd-supply = <&amp_20v>;
		firmware = "sy6045s-tweeters-settings.txt";
		/* reg must be <= SY6045S_MAX_REGISTER (0xb0): the old
		 * <0xff 0x06> pair came from a misread vendor dump (ff was
		 * its EOF marker, not a register) and NAKed the whole probe */
		restore-regs = <0x06 0x08>;
		status = "okay";
	};

	woofer_amp: sy6045s@2b {
		compatible = "silergy,sy6045s";
		reg = <0x2b>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Woofer";
		pbtl-mode;
		vddio-supply = <&vcc_3v3>;
		pvdd-supply = <&amp_20v>;
		firmware = "sy6045s-woofer-settings.txt";
		/* reg must be <= SY6045S_MAX_REGISTER (0xb0): the old
		 * <0xff 0x06> pair came from a misread vendor dump (ff was
		 * its EOF marker, not a register) and NAKed the whole probe */
		restore-regs = <0x06 0x08>;
		status = "okay";
	};

	feedback_adc: es7210@40 {
		compatible = "everest,es7210_2ch";
		reg = <0x40>;
		#sound-dai-cells = <0>;
		clocks = <&clkc_audio AUD_CLKID_MST_B_MCLK>;
		clock-names = "mclk";
		status = "okay";
	};

	rtc: pcf8563@51 {
		compatible = "nxp,pcf8563";
		reg = <0x51>;
		status = "okay";
	};

	ltr308: light-sensor@53 {
		compatible = "liteon,ltr308als01", "liteon,ltr308";
		reg = <0x53>;
		status = "okay";
	};
};

/* I2C3 - not used on this board (no TAS5707/AD82584F) */
&i2c3 {
	status = "disabled";
};

&gpio_ao {
};

/* WiFi RTL8822CS SDIO (matches vendor caps) */
&sd_emmc_a {
	status = "okay";
	pinctrl-0 = <&sdio_pins>;
	pinctrl-1 = <&sdio_clk_gate_pins>;
	pinctrl-names = "default", "clk-gate";
	#address-cells = <1>;
	#size-cells = <0>;
	bus-width = <4>;
	/* cap-sd-highspeed intentionally omitted: RTL8822CS efuse dump
	 * (long CMD53) corrupted at HS on meson-gx-mmc w/o tuning */
	cap-sdio-irq;
	/* Safe RTL8822CS timing for first bring-up.
	 * Re-enable UHS modes one at a time once rtw88 probing and
	 * throughput are verified on hardware. */
	max-frequency = <25000000>;
	non-removable;
	disable-wp;
	keep-power-in-suspend;
	mmc-pwrseq = <&sdio_pwrseq>;
	vmmc-supply = <&vddao_3v3>;
	vqmmc-supply = <&vddio_ao1v8>;

	wifi@1 {
		reg = <1>;
		compatible = "realtek,rtl8822cs";
	};
};

/* Bluetooth RTL8822CS-BT on UART_A */
&uart_A {
	status = "okay";
	pinctrl-0 = <&uart_a_pins>;

	bluetooth: bluetooth {
		compatible = "realtek,rtl8822cs-bt";
		/* 0x53 == GPIOX_18 (verified against sm1 pin table) */
		enable-gpios = <&gpio GPIOX_18 GPIO_ACTIVE_HIGH>;
		/*
		 * Wake lines intentionally omitted:
		 *  - device-wake was GPIOX_17 which conflicts with the
		 *    zigbee radio reset line;
		 *  - host-wake decoded to GPIOAO_0, unverified trace.
		 * btrtl serdev works without them; add back only after
		 * tracing the board.
		 */
		/* vendor config keeps FW init at 115200; H5 negotiates up */
		max-speed = <115200>;
		status = "okay";
	};
};

/* Zigbee radio on UART_AO_B (GPIOAO_8 TX, GPIOAO_9 RX)
 * Disabled: GPIOAO_8 conflicts with tdm_ao_b_sclk needed for audio TDM B.
 * Enable only if Zigbee module is populated and audio TDM B moved to different pins. */
/* Zigbee radio (Tuya TZ9213-2782 module) on UART_AO_B.
 * Stock DTB routes it to pins 2/3 (uart_ao_b_2_3_pins), which do NOT
 * conflict with audio TDM-B (AO4/6/7/8 + MCLK AO9).
 * No serdev driver: userspace talks to /dev/ttyAML1 directly
 * (coordinator firmware flash + NCP passthrough). */
&uart_AO_B {
	status = "okay";
	pinctrl-0 = <&uart_ao_b_2_3_pins>;
	pinctrl-names = "default";
};

/* PWM_E for 32.768kHz WiFi clock */
&pwm_ef {
	status = "okay";
	pinctrl-0 = <&pwm_e_pins>;
	pinctrl-names = "default";
};

/* Volume potentiometer on SAR ADC channel 0
 * Handled by userspace daemon (atrivolume) via IIO */

/* SPI LED screen (Gowin FPGA / Yandex LED screen) */
&spicc1 {
	status = "okay";
	pinctrl-0 = <&spicc1_pins>, <&spicc1_ss0_pins>;
	pinctrl-names = "default";
	cs-gpios = <&gpio GPIOH_8 GPIO_ACTIVE_LOW>;

	led_screen: led-screen@0 {
		compatible = "gowin,led-screen", "yandex,led-screen", "yandex,station-max-led-screen";
		reg = <0>;
		spi-max-frequency = <25000000>;
		max-brightness = <200>;
		reset-gpios = <&gpio GPIOX_9 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};

