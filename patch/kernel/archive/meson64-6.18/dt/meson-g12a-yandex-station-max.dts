// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Device Tree Source for Yandex Station Max (Quasar 2)
 *
 * Based on Amlogic Meson G12A S905X2
 * Mainline Linux 6.x DTS
 */

/dts-v1/;

#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/gpio/meson-g12a-gpio.h>
#include <dt-bindings/sound/meson-g12a-tohdmitx.h>
#include <dt-bindings/clock/axg-audio-clkc.h>
#include "meson-g12a.dtsi"

/ {
	compatible = "yandex,station-max", "amlogic,g12a";
	model = "Yandex Station Max";

	aliases {
		serial0 = &uart_AO;
		serial1 = &uart_A;
		serial2 = &uart_AO_B;
		ethernet0 = &ethmac;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x80000000>; /* 2GB RAM */
	};

	/* DC 12V/20V Main Supply */
	dc_in: regulator-dc_in {
		compatible = "regulator-fixed";
		regulator-name = "DC_IN";
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
		regulator-boot-on;
		regulator-always-on;
	};

	vcc_5v: regulator-vcc_5v {
		compatible = "regulator-fixed";
		regulator-name = "VCC_5V";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&dc_in>;
		regulator-boot-on;
		regulator-always-on;
	};

	vcc_3v3: regulator-vcc_3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VCC_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_5v>;
		regulator-boot-on;
		regulator-always-on;
	};

	/* CPU DVFS Voltage Regulator (PWM_AO_D) */
	vddcpu: regulator-vddcpu {
		compatible = "pwm-regulator";
		regulator-name = "VDDCPU";
		regulator-min-microvolt = <721000>;
		regulator-max-microvolt = <1022000>;
		pwm-supply = <&dc_in>;
		pwms = <&pwm_AO_cd 1 1250 0>;
		pwm-dutycycle-range = <100 0>;
		regulator-boot-on;
		regulator-always-on;
	};

	vddio_ao1v8: regulator-vddio-ao1v8 {
		compatible = "regulator-fixed";
		regulator-name = "VDDIO_AO1V8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_3v3>;
		regulator-always-on;
	};

	flash_1v8: regulator-flash_1v8 {
		compatible = "regulator-fixed";
		regulator-name = "FLASH_1V8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_3v3>;
		regulator-always-on;
	};

	emmc_pwrseq: emmc-pwrseq {
		compatible = "mmc-pwrseq-emmc";
		reset-gpios = <&gpio BOOT_12 GPIO_ACTIVE_LOW>;
	};

	usb_pwr_en: regulator-usb-pwr-en {
		compatible = "regulator-fixed";
		regulator-name = "USB_PWR_EN";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc_5v>;
		regulator-boot-on;
		regulator-always-on;
	};

	/* HDMI connector */
	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&hdmi_tx_tmds_out>;
			};
		};
	};

	/* SY6045S amplifier 20V supply enable (GPIOX_10) */
	amp_20v: regulator-20v-amp {
		compatible = "regulator-fixed";
		regulator-name = "20V_AMPL";
		regulator-min-microvolt = <20000000>;
		regulator-max-microvolt = <20000000>;
		gpio = <&gpio GPIOX_10 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/* Mic Mute Push-Button */
	gpio_keys: gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&button_pullup_pins>;

		button-micmute {
			label = "Mic Mute";
			linux,code = <KEY_MICMUTE>; /* 248 */
			gpios = <&gpio GPIOA_15 GPIO_ACTIVE_LOW>;
			debounce-interval = <20>;
			wakeup-source;
		};
	};

	/* Rotary Volume Encoder (A: GPIOA_0 [0x31], B: GPIOAO_10 [0x0a]) */
	rotary_volume: rotary-volume {
		compatible = "rotary-volume";
		gpios = <&gpio GPIOA_0 GPIO_ACTIVE_LOW>,
			<&gpio_ao GPIOAO_10 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	/* ZigBee Hardware Control (reset: GPIOX_17 [0x52], boot: GPIOX_11 [0x4c]) */
	zigbee_control: zigbee-control {
		compatible = "yandex,zigbee-control";
		zb-reset-gpios = <&gpio GPIOX_17 GPIO_ACTIVE_LOW>;
		zb-boot-gpios  = <&gpio GPIOX_11 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	/* Quasar PCBA ID Parser */
	pcba_ids: pcba-ids {
		compatible = "yandex,pcba-ids", "pcba-ids";
		eeproms = <&pcba_eeprom>;
		eeprom-names = "mainboard";
		status = "okay";
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		/* Vendor DTB: wifi.power_on_pin = <0x16 0x48 0x00>.
		 * 0x48 (72 decimal) in meson-g12a-gpio.h is GPIOX_7.
		 * mmc-pwrseq-simple deasserts reset-gpios to enable the chip.
		 * Deassert with ACTIVE_LOW drives pin HIGH = WL_REG_ON high = chip ON. */
		reset-gpios = <&gpio GPIOX_7 GPIO_ACTIVE_LOW>;
		clocks = <&wifi32k>;
		clock-names = "ext_clock";
		post-power-on-delay-ms = <200>;
	};

	wifi32k: wifi32k {
		compatible = "pwm-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		pwms = <&pwm_ef 0 30541 0>;
	};

	/* PDM microphone array (4 channels) */
	dmics: dmics {
		compatible = "dmic-codec";
		#sound-dai-cells = <0>;
		num-channels = <4>;
		wakeup-delay-ms = <50>;
		sound-name-prefix = "DMIC";
	};

	sound {
		compatible = "amlogic,axg-sound-card";
		model = "ATRISTATION";
		audio-aux-devs = <&tdmout_b>;
		audio-widgets = "Headphone", "Headphones";
		audio-routing =
			"Headphones", "LOUT",
			"Headphones", "ROUT",
			"TDMOUT_B IN 0", "FRDDR_A OUT 0",
			"TDM_B Playback", "TDMOUT_B OUT",
			"TODDR_A IN 4", "PDM Capture";

		clocks = <&clkc CLKID_MPLL2>,
			 <&clkc CLKID_MPLL0>;
		assigned-clocks = <&clkc CLKID_MPLL2>,
				  <&clkc CLKID_MPLL0>;
		assigned-clock-rates = <294912000>,
				       <270950400>;

		dai-link-0 {
			sound-dai = <&frddr_a>;
		};

		dai-link-1 {
			sound-dai = <&toddr_a>;
		};

		dai-link-2 {
			sound-dai = <&tdmif_b>;
			dai-format = "i2s";
			bitclock-master = <&tdmif_b>;
			frame-master = <&tdmif_b>;
			dai-tdm-slot-tx-mask-0 = <1 1>;
			mclk-fs = <256>;

			codec-0 {
				sound-dai = <&sy6045s_tweeter>;
			};
			codec-1 {
				sound-dai = <&sy6045s_woofer>;
			};
			codec-2 {
				sound-dai = <&es8156_dac>;
			};
		};

		dai-link-3 {
			sound-dai = <&pdm>;
			codec-0 {
				sound-dai = <&dmics>;
			};
		};
	};
};

/* Audio Controllers */
&clkc_audio {
	status = "okay";
};

&frddr_a {
	status = "okay";
};

&toddr_a {
	status = "okay";
};

&tdmif_b {
	status = "okay";
	pinctrl-0 = <&tdm_ao_b_dout2_pins>, <&tdm_ao_b_din0_pins>,
		    <&tdm_ao_b_fs_pins>, <&tdm_ao_b_sclk_pins>,
		    <&mclk0_ao_pins>;
	pinctrl-names = "default";
};

&tdmout_b {
	status = "okay";
};

&pdm {
	status = "okay";
	pinctrl-0 = <&pdm_dclk_c_pins>, <&pdm_din0_c_pins>,
		    <&pdm_din1_c_pins>, <&pdm_din2_c_pins>,
		    <&pdm_din3_c_pins>;
	pinctrl-names = "default";
};

/* SPI1 - Gowin FPGA (25x16 LED Screen & Touch) */
&spicc1 {
	status = "okay";
	pinctrl-names = "default";
	num-cs = <1>;
	cs-gpios = <&gpio GPIOH_7 GPIO_ACTIVE_LOW>;

	gowin_screen: led-panel@0 {
		compatible = "gowin,led-screen", "atri,led-panel", "ya,led-panel", "yandex,station-max-led-screen", "yandex,led-screen";
		reg = <0>;
		spi-max-frequency = <4000000>;
		max-brightness = <200>;
		pinctrl-names = "default", "jtag";
		pinctrl-0 = <&spicc1_pins>;
		pinctrl-1 = <&led_panel_jtag_pins>;
		reset-gpios = <&gpio GPIOX_9 GPIO_ACTIVE_LOW>;
		jtag_tck_desc = <0xff634468 0x08>;
		jtag_reconfig-gpios = <&gpio BOOT_0 GPIO_ACTIVE_LOW>;
		jtag_sel-gpios = <&gpio_ao GPIOE_2 GPIO_ACTIVE_HIGH>;
		jtag_tck-gpios = <&gpio GPIOH_8 GPIO_ACTIVE_HIGH>;
		jtag_tdi-gpios = <&gpio GPIOH_5 GPIO_ACTIVE_HIGH>;
		jtag_tdo-gpios = <&gpio GPIOH_6 GPIO_ACTIVE_HIGH>;
		jtag_tms-gpios = <&gpio GPIOH_7 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&periphs_pinctrl {
	led_panel_jtag_pins: led-panel-jtag {
		mux {
			groups = "GPIOH_5", "GPIOH_6", "GPIOH_7", "GPIOH_8";
			function = "gpio_periphs";
			bias-disable;
		};
	};

	button_pullup_pins: button-pullup {
		mux {
			groups = "GPIOA_15";
			function = "gpio_periphs";
			bias-pull-up;
		};
	};
};

/* I2C Bus 2: Audio Amplifiers and Codecs */
&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2_sda_z_pins>, <&i2c2_sck_z_pins>;
	pinctrl-names = "default";

	/* Silergy SY6045S Woofer Amplifier */
	sy6045s_woofer: amplifier@2b {
		compatible = "silergy,sy6045s";
		reg = <0x2b>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Woofer";
		pbtl-mode;
		vddio-supply = <&vcc_3v3>;
		pvdd-supply = <&amp_20v>;
		firmware = "sy6045s-woofer-settings.txt";
		restore-regs = <0x06 0x08>;
		status = "okay";
	};

	/* Silergy SY6045S Tweeter Amplifier */
	sy6045s_tweeter: amplifier@2a {
		compatible = "silergy,sy6045s";
		reg = <0x2a>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Tweeters";
		vddio-supply = <&vcc_3v3>;
		pvdd-supply = <&amp_20v>;
		firmware = "sy6045s-tweeters-settings.txt";
		restore-regs = <0x06 0x08>;
		status = "okay";
	};

	/* Everest ES8156 Headphone DAC */
	es8156_dac: codec@8 {
		compatible = "everest,es8156";
		reg = <0x08>;
		#sound-dai-cells = <0>;
		clocks = <&clkc_audio AUD_CLKID_MST_B_MCLK>;
		clock-names = "mclk";
		status = "okay";
	};

	/* Everest ES7210 2-Channel Feedback ADC */
	es7210_adc: codec@40 {
		compatible = "everest,es7210_2ch", "everest,es7210";
		reg = <0x40>;
		#sound-dai-cells = <0>;
		clocks = <&clkc_audio AUD_CLKID_MST_B_MCLK>;
		clock-names = "mclk";
		status = "okay";
	};

	/* Lite-On LTR-308ALS Ambient Light Sensor */
	ltr308: light-sensor@53 {
		compatible = "liteon,ltr308als01", "liteon,ltr308", "liteon,ltrf216a";
		reg = <0x53>;
		status = "okay";
	};

	pcba_eeprom: eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
		vcc-supply = <&vcc_3v3>;
		status = "okay";
	};
};

/* Zigbee radio (Tuya TZ9213-2782 module) on UART_AO_B */
&uart_AO_B {
	status = "okay";
	pinctrl-0 = <&uart_ao_b_2_3_pins>;
	pinctrl-names = "default";
};

/* PWM_E for 32.768kHz WiFi/BT LPO clock */
&pwm_ef {
	status = "okay";
	pinctrl-0 = <&pwm_e_pins>;
	pinctrl-names = "default";
};

/* WiFi RTL8822CS SDIO */
&sd_emmc_a {
	status = "okay";
	pinctrl-0 = <&sdio_pins>;
	pinctrl-1 = <&sdio_clk_gate_pins>;
	pinctrl-names = "default", "clk-gate";
	#address-cells = <1>;
	#size-cells = <0>;
	bus-width = <4>;
	cap-sd-highspeed;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	max-frequency = <100000000>;
	cap-sdio-irq;
	non-removable;
	disable-wp;
	keep-power-in-suspend;
	mmc-pwrseq = <&sdio_pwrseq>;
	vmmc-supply = <&vcc_3v3>;
	vqmmc-supply = <&vddio_ao1v8>;

	wifi@1 {
		reg = <1>;
		compatible = "realtek,rtl8822cs";
	};
};

/* Bluetooth RTL8822CS-BT on UART_A */
&uart_A {
	status = "okay";
	pinctrl-0 = <&uart_a_pins>, <&uart_a_cts_rts_pins>;
	pinctrl-names = "default";
	uart-has-rtscts;

	bluetooth: bluetooth {
		compatible = "realtek,rtl8822cs-bt";
		/* Vendor DTB: reset=0x53 (83 decimal in meson-g12a-gpio.h is GPIOX_18) */
		enable-gpios = <&gpio GPIOX_18 GPIO_ACTIVE_HIGH>;
		/* Vendor DTB: hostwake=0x55 (84 decimal in mainline meson-g12a-gpio.h is GPIOX_19) */
		host-wake-gpios = <&gpio GPIOX_19 GPIO_ACTIVE_HIGH>;
		max-speed = <3000000>;
		clocks = <&wifi32k>;
		clock-names = "lpo";
		status = "okay";
	};
};

/* CPU DVFS */
&cpu0 {
	cpu-supply = <&vddcpu>;
};

&cpu1 {
	cpu-supply = <&vddcpu>;
};

&cpu2 {
	cpu-supply = <&vddcpu>;
};

&cpu3 {
	cpu-supply = <&vddcpu>;
};

&pwm_AO_cd {
	pinctrl-0 = <&pwm_ao_d_e_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* Gigabit Ethernet */
&ethmac {
	status = "okay";
	pinctrl-0 = <&eth_pins>, <&eth_rgmii_pins>;
	pinctrl-names = "default";
	phy-mode = "rgmii";
	phy-handle = <&external_phy>;
	amlogic,tx-delay-ns = <2>;
};

&ext_mdio {
	external_phy: ethernet-phy@0 {
		reg = <0>;
		max-speed = <1000>;
	};
};

/* HDMI Display Output */
&hdmi_tx {
	status = "okay";
	pinctrl-0 = <&hdmitx_hpd_pins>, <&hdmitx_ddc_pins>;
	pinctrl-names = "default";
	hdmi-supply = <&vcc_5v>;
};

&hdmi_tx_tmds_port {
	hdmi_tx_tmds_out: endpoint {
		remote-endpoint = <&hdmi_connector_in>;
	};
};

/* eMMC Internal Flash Storage */
&sd_emmc_c {
	status = "okay";
	pinctrl-0 = <&emmc_ctrl_pins>, <&emmc_data_8b_pins>, <&emmc_ds_pins>;
	pinctrl-1 = <&emmc_clk_gate_pins>;
	pinctrl-names = "default", "clk-gate";
	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	max-frequency = <200000000>;
	disable-wp;
	mmc-pwrseq = <&emmc_pwrseq>;
	vmmc-supply = <&vcc_3v3>;
	vqmmc-supply = <&flash_1v8>;
};

/* USB Host / OTG */
&usb {
	status = "okay";
	vbus-supply = <&usb_pwr_en>;
};

&usb2_phy0 {
	phy-supply = <&vcc_5v>;
};

/* IR Remote Receiver */
&ir {
	status = "okay";
	pinctrl-0 = <&remote_input_ao_pins>;
	pinctrl-names = "default";
};

/* SAR ADC for Analog Knob / Diagnostics */
&saradc {
	status = "okay";
	vref-supply = <&vddio_ao1v8>;
};
