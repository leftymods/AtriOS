[Unit]
Description=Stop Boot Animation on Login Screen
After=graphical-session-pre.target atri-led.service
Before=graphical-session.target

[Service]
Type=oneshot
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=full
ExecStart=/usr/bin/atrledctl play notification_passive

[Install]
WantedBy=graphical-session-pre.target
