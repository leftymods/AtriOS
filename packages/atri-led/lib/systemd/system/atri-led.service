[Unit]
Description=AtriStation LED ring effects daemon
After=local-fs.target

[Service]
Type=simple
# No idle animation: atri-main owns ambient ring state and yields it
# to this daemon via /run/atriled.override while an effect plays.
ExecStart=/usr/bin/atrled daemon -f
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
